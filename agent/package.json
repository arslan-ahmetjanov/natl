{
  "name": "@natl/agent",
  "version": "0.1.0",
  "description": "NATL Agent — generate YAML tests from git diffs via OpenAI-compatible LLM",
  "license": "MIT",
  "type": "module",
  "bin": {
    "natl-agent": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "eval",
    "action.yml",
    "Dockerfile",
    "docker-compose.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "natl",
    "agent",
    "ci",
    "github-actions",
    "llm",
    "yaml",
    "testing"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/semantic.test.ts src/prompt.test.ts src/validate.test.ts src/context.test.ts src/llm.test.ts src/config.test.ts src/treesitter.test.ts src/heal.test.ts src/normalize.test.ts src/pipeline.heal.test.ts src/publish.test.ts",
    "eval": "node --import tsx src/eval-validate.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@natl/core": "^1.0.0",
    "ajv": "^8.20.0",
    "simple-git": "^3.27.0",
    "tree-sitter-wasm": "^1.1.3",
    "web-tree-sitter": "^0.25.10",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arslan-ahmetjanov/natl.git",
    "directory": "agent"
  },
  "homepage": "https://arslan-ahmetjanov.github.io/natl/",
  "bugs": {
    "url": "https://github.com/arslan-ahmetjanov/natl/issues"
  }
}
