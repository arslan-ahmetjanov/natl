{
  "name": "@natl/adapter-cypress",
  "version": "1.0.0",
  "description": "Experimental Cypress engine adapter for NATL (MVP; not Playwright parity)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "brand",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "natl",
    "cypress",
    "adapter",
    "e2e",
    "testing"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/index.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@natl/core": "^1.0.0",
    "cypress": ">=13.0.0"
  },
  "devDependencies": {
    "@natl/core": "^1.0.0",
    "@types/node": "^22.10.5",
    "cypress": "^14.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arslan-ahmetjanov/natl.git",
    "directory": "adapter-cypress"
  },
  "homepage": "https://arslan-ahmetjanov.github.io/natl/",
  "bugs": {
    "url": "https://github.com/arslan-ahmetjanov/natl/issues"
  }
}
