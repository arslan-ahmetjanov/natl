// Declarative Jenkins pipeline for NATL Agent (MVP).
// Copy to repo root as `Jenkinsfile` or load from examples/ci/Jenkinsfile.
//
// Credentials (Jenkins → Credentials):
//   llm-api-key — Secret text → LLM_API_KEY (required for cloud LLM)
//
// Optional env (set via Credentials Binding / folder properties — do not commit secrets):
//   GITLAB_TOKEN, CI_PROJECT_ID, CI_MERGE_REQUEST_IID, CI_API_V4_URL  → GitLab MR note
//   GITHUB_TOKEN, GITHUB_REPOSITORY                                   → GitHub PR comment
//
// Multibranch / PR jobs often expose CHANGE_ID, CHANGE_TARGET.
// Default mode is stdout (safe dry-run). Set AGENT_MODE=comment to publish.

pipeline {
  agent any

  options {
    timestamps()
  }

  parameters {
    choice(name: 'AGENT_MODE', choices: ['stdout', 'comment'], description: 'stdout = log only; comment = post via GitHub/GitLab API')
    choice(name: 'COMMENT_PROVIDER', choices: ['auto', 'github', 'gitlab', 'stdout'], description: 'Comment backend when AGENT_MODE=comment')
    string(name: 'BASE_REF', defaultValue: '', description: 'Diff base (empty → origin/main or CHANGE_TARGET)')
    string(name: 'LLM_BASE_URL', defaultValue: 'https://api.openai.com/v1', description: 'OpenAI-compatible …/v1')
    string(name: 'LLM_MODEL', defaultValue: 'gpt-4o-mini', description: 'Model id')
    string(name: 'LLM_PROVIDER', defaultValue: 'openai', description: 'openai | ollama | azure | custom')
  }

  environment {
    NATL_AGENT_MODE = "${params.AGENT_MODE}"
    NATL_AGENT_COMMENT_PROVIDER = "${params.COMMENT_PROVIDER}"
    NATL_AGENT_TEST_ROOTS = 'tests,examples'
    OPENAI_BASE_URL = "${params.LLM_BASE_URL}"
    OPENAI_MODEL = "${params.LLM_MODEL}"
    NATL_AGENT_PROVIDER = "${params.LLM_PROVIDER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'git fetch --no-tags origin "+refs/heads/*:refs/remotes/origin/*" || true'
      }
    }

    stage('Install agent') {
      steps {
        sh 'npm install -g @natl/agent'
      }
    }

    stage('Suggest NATL tests') {
      steps {
        withCredentials([
          string(credentialsId: 'llm-api-key', variable: 'LLM_API_KEY'),
        ]) {
          script {
            def base = params.BASE_REF?.trim()
            if (!base) {
              base = env.CHANGE_TARGET ? "origin/${env.CHANGE_TARGET}" : 'origin/main'
            }
            // GitLab Branch Source plugin (when present)
            if (env.gitlabMergeRequestIid) {
              env.CI_MERGE_REQUEST_IID = env.gitlabMergeRequestIid
            }
            if (env.gitlabMergeRequestTargetProjectId) {
              env.CI_PROJECT_ID = env.gitlabMergeRequestTargetProjectId
            }

            sh """
              export OPENAI_API_KEY="\$LLM_API_KEY"
              natl-agent \\
                --mode "${params.AGENT_MODE}" \\
                --comment-provider "${params.COMMENT_PROVIDER}" \\
                --base "${base}" \\
                --head HEAD \\
                --provider "${params.LLM_PROVIDER}" \\
                --base-url "${params.LLM_BASE_URL}" \\
                --model "${params.LLM_MODEL}"
            """
          }
        }
      }
    }
  }

  post {
    always {
      // Console / Blue Ocean shows the agent body when mode=stdout.
      // For PR/MR comments use AGENT_MODE=comment + GitHub/GitLab tokens in the environment.
      echo 'NATL Agent finished. Review console output (or MR/PR comment if mode=comment).'
    }
  }
}
