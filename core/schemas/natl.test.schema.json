{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@natl/core/schemas/natl.test.schema.json",
  "title": "NATL test scenario",
  "description": "Primary: compact steps as valid YAML (sibling keys / string forms), e.g. fill+with, assert+text|visible, wait: \"sel visible\". Nested object forms are advanced. One-liner secondary keys on the same line are runtime sugar (preprocessor) and are not valid YAML for IDE.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "description": "Scenario display name" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Labels for CLI --tags filtering (OR match)"
    },
    "engine": {
      "type": "string",
      "enum": ["playwright", "selenium", "cypress", "http"],
      "description": "Engine id for this scenario (UI adapters or http = HTTP-only)"
    },
    "timeout": {
      "type": "number",
      "minimum": 0,
      "description": "Default step timeout in milliseconds"
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "description": "Extra full-scenario attempts after failure"
    },
    "vars": {
      "type": "object",
      "additionalProperties": true,
      "description": "Scenario variables ($name)"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string" },
            "encoding": { "type": "string" }
          }
        },
        "vault": { "type": "object", "additionalProperties": true },
        "aws": { "type": "object", "additionalProperties": true }
      }
    },
    "imports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "data": {
      "type": "array",
      "items": {},
      "description": "Array for for-loops ($data); prefer cases: for simple tables"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Data-driven rows: each object merges into vars and runs steps once (reported as separate results)"
    },
    "before_each": {
      "type": "array",
      "items": { "$ref": "#/definitions/step" }
    },
    "after_each": {
      "type": "array",
      "items": { "$ref": "#/definitions/step" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/step" }
    },
    "elements": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "strategy": {
                "type": "string",
                "description": "Web strategies: css | xpath (adapters may support more)"
              },
              "value": { "type": "string" }
            }
          }
        ]
      },
      "description": "Page Object locators: string uses locator_strategy (default css), or { strategy, value }"
    },
    "locator_strategy": {
      "type": "string",
      "minLength": 1,
      "description": "Default strategy for string elements / inline selectors on this file (web: css | xpath)"
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/step" }
      },
      "description": "Page Object style named action sequences"
    }
  },
  "definitions": {
    "stepCommon": {
      "type": "object",
      "properties": {
        "engine": { "type": "string", "enum": ["playwright", "selenium", "cypress", "http"] },
        "timeout": { "type": "number", "minimum": 0 },
        "save": { "type": "string" },
        "debug": { "type": "boolean" }
      }
    },
    "step": {
      "allOf": [
        { "$ref": "#/definitions/stepCommon" },
        {
          "oneOf": [
            {
              "required": ["goto"],
              "properties": {
                "goto": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["url"],
                      "properties": {
                        "url": { "type": "string" },
                        "timeout": { "type": "number", "minimum": 0 }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["click"],
              "properties": {
                "click": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" },
                        "selector": { "type": "string" },
                        "timeout": { "type": "number", "minimum": 0 }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["tap"],
              "description": "Alias for click (same step)",
              "properties": {
                "tap": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" },
                        "selector": { "type": "string" },
                        "timeout": { "type": "number", "minimum": 0 }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["fill"],
              "properties": {
                "fill": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Compact locator; pair with sibling `with`"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" },
                        "with": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "with": {
                  "type": "string",
                  "description": "Compact sibling: value to type"
                }
              }
            },
            {
              "required": ["select"],
              "properties": {
                "select": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "with": { "type": "string" }
              }
            },
            {
              "required": ["check"],
              "properties": {
                "check": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["uncheck"],
              "properties": {
                "uncheck": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["scroll"],
              "description": "Scroll target into view (default) or by deltas",
              "properties": {
                "scroll": {
                  "oneOf": [
                    { "type": "string", "description": "Locator; pair with into_view / delta_x / delta_y" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" },
                        "selector": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "into_view": { "type": "boolean" },
                "delta_x": { "type": "number" },
                "delta_y": { "type": "number" }
              }
            },
            {
              "required": ["swipe"],
              "description": "Swipe / drag from target; requires direction",
              "properties": {
                "swipe": {
                  "oneOf": [
                    { "type": "string", "description": "Locator; pair with direction" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" },
                        "selector": { "type": "string" },
                        "direction": {
                          "type": "string",
                          "enum": ["left", "right", "up", "down"]
                        },
                        "distance": { "type": "number", "minimum": 0 }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "direction": {
                  "type": "string",
                  "enum": ["left", "right", "up", "down"]
                },
                "distance": { "type": "number", "minimum": 0 }
              }
            },
            {
              "required": ["long_press"],
              "description": "Press and hold on target",
              "properties": {
                "long_press": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" },
                        "selector": { "type": "string" },
                        "duration_ms": { "type": "number", "minimum": 0 }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "duration_ms": { "type": "number", "minimum": 0 }
              }
            },
            {
              "required": ["wait"],
              "properties": {
                "wait": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Compact: \".dashboard visible\", \"2000 ms\", or selector (default visible)"
                    },
                    { "type": "number" },
                    {
                      "type": "object",
                      "properties": {
                        "selector": { "type": "string" },
                        "state": {
                          "type": "string",
                          "enum": ["visible", "hidden", "attached", "detached"]
                        },
                        "ms": { "type": "number", "minimum": 0 }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["screenshot"],
              "properties": {
                "screenshot": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "file": { "type": "string" },
                        "full_page": { "type": "boolean" }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "full_page": { "type": "boolean" }
              }
            },
            {
              "required": ["assert"],
              "properties": {
                "assert": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "additionalProperties": true
                    }
                  ]
                },
                "text": {
                  "type": "string",
                  "description": "Exact text of the locator (getText)"
                },
                "is": {
                  "type": "string",
                  "description": "Alias for text: (exact match)"
                },
                "contains": {
                  "type": "string",
                  "description": "Substring match on locator text"
                },
                "visible": {},
                "hidden": {},
                "attr": { "type": "string" },
                "soft": {
                  "type": "boolean",
                  "description": "Preferred soft mode: failure is recorded and the scenario continues"
                }
              }
            },
            {
              "required": ["soft_assert"],
              "properties": {
                "soft_assert": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "additionalProperties": true
                    }
                  ],
                  "description": "Alias for assert + soft: true (prefer soft: true on assert)"
                },
                "text": { "type": "string" },
                "is": { "type": "string" },
                "contains": { "type": "string" },
                "visible": {},
                "hidden": {},
                "attr": { "type": "string" }
              }
            },
            {
              "required": ["api"],
              "properties": {
                "api": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "method": {
                          "type": "string",
                          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
                        },
                        "url": { "type": "string" },
                        "headers": {
                          "type": "object",
                          "additionalProperties": { "type": "string" }
                        },
                        "body": {},
                        "save": { "type": "string" },
                        "timeout": { "type": "number", "minimum": 0 }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "method": { "type": "string" },
                "headers": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "body": {}
              }
            },
            {
              "required": ["set"],
              "properties": {
                "set": { "type": "string" }
              }
            },
            {
              "required": ["get_text"],
              "properties": {
                "get_text": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["get_attr"],
              "properties": {
                "get_attr": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "locator": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "attr": { "type": "string" }
              }
            },
            {
              "required": ["log"],
              "properties": {
                "log": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "message": { "type": "string" },
                        "level": {
                          "type": "string",
                          "enum": ["info", "debug", "warn", "error"]
                        }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["debug"],
              "properties": {
                "debug": { "type": "boolean" }
              }
            },
            {
              "required": ["if", "then"],
              "properties": {
                "if": { "type": "string" },
                "then": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/step" }
                },
                "else": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/step" }
                }
              }
            },
            {
              "required": ["for", "steps"],
              "properties": {
                "for": { "type": "string" },
                "steps": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/step" }
                }
              }
            },
            {
              "required": ["repeat", "steps"],
              "properties": {
                "repeat": {
                  "oneOf": [
                    { "type": "integer", "minimum": 0 },
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "until": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "until": { "type": "string" },
                "times": { "type": "integer", "minimum": 0 },
                "steps": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/step" }
                }
              }
            },
            {
              "required": ["parallel"],
              "properties": {
                "parallel": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": { "$ref": "#/definitions/step" }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "wait": { "type": "string", "enum": ["all", "any"] },
                        "steps": {
                          "type": "array",
                          "items": { "$ref": "#/definitions/step" }
                        }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            {
              "required": ["do"],
              "properties": {
                "do": {
                  "type": "string",
                  "description": "POM action: page.action or unambiguous action name"
                },
                "vars": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Optional args bag; sibling keys (except reserved) also merge into action scope"
                }
              },
              "additionalProperties": true
            },
            {
              "required": ["with", "steps"],
              "description": "Run nested steps under another engine (e.g. with: http)",
              "properties": {
                "with": {
                  "type": "string",
                  "description": "Engine id for the block (http | playwright | …)"
                },
                "steps": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/step" }
                }
              }
            },
            {
              "required": ["get"],
              "description": "HTTP GET (engine http / with: http); prefer over api:",
              "properties": {
                "get": { "type": "string" },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "save": { "type": "string" },
                "timeout": { "type": "number", "minimum": 0 }
              }
            },
            {
              "required": ["post"],
              "description": "HTTP POST",
              "properties": {
                "post": { "type": "string" },
                "body": {},
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "save": { "type": "string" },
                "timeout": { "type": "number", "minimum": 0 }
              }
            },
            {
              "required": ["put"],
              "properties": {
                "put": { "type": "string" },
                "body": {},
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "save": { "type": "string" }
              }
            },
            {
              "required": ["patch"],
              "properties": {
                "patch": { "type": "string" },
                "body": {},
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "save": { "type": "string" }
              }
            },
            {
              "required": ["delete"],
              "properties": {
                "delete": { "type": "string" },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "save": { "type": "string" }
              }
            },
            {
              "required": ["include"],
              "properties": {
                "include": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "file": { "type": "string" },
                        "action": { "type": "string" },
                        "vars": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": true
                    }
                  ]
                },
                "vars": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          ]
        }
      ]
    }
  }
}
